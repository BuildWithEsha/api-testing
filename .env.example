# ─── Copy this file to .env and fill in real values ───────────

# MySQL root password (used to create the database/user)
MYSQL_ROOT_PASSWORD=change_this_root_password

# Database connection (app uses these to connect to MySQL)
DB_NAME=demo_api_db
DB_USER=demo_user
DB_PASSWORD=change_this_password

# ─── Admin Password ────────────────────────────────────────────
# Protects the /admin/keys endpoints and the frontend UI
# Set this to any strong password — you'll enter it in the frontend login
# Generate one: openssl rand -hex 16
ADMIN_PASSWORD=change_this_admin_password
